# Example environment variables for ongevallenradar
# Copy this file to .env and update the values as needed

# WFS/Geoserver configuration
VITE_WFS_HOST=https://geoserver.stichtingimn.nl
VITE_WFS_PATH=/geoserver/ows

# Tile server configuration
VITE_TILE_SERVER_URL_TEMPLATE=https://kaartserver.incidentcentrale.nl/{z}/{x}/{y}.png

# PDOK Locatieserver API base URL
VITE_PDOK_API_BASE=https://api.pdok.nl/bzk/locatieserver/search/v3_1

# Base path configuration for deployment (use / for root deployment)
VITE_BASE_PATH=/