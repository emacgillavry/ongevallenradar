# Base environment configuration for ongevallenradar
# Provides defaults for development
# Create .env.production to override specific values for production builds

# Use static GeoJSON files instead of live GeoServer
# true = Use local test data from /src/assets/data/*.json (for development/testing)
# false = Use live WFS data from GeoServer (for production)
VITE_USE_STATIC_DATA=true

# WFS/GeoServer configuration (used when VITE_USE_STATIC_DATA=false)
VITE_WFS_HOST=
VITE_WFS_PATH=/geoserver/ows

# Tile server for base map tiles
# Development: OpenStreetMap public tiles
# Production: Override in .env.production
VITE_TILE_SERVER_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Geocoder API URLs (use {SEARCH_TERM} placeholder for search terms)
# PDOK example:
# VITE_GEOCODER_SEARCH_URL=https://api.pdok.nl/bzk/locatieserver/search/v3_1/suggest?rows=10&fq=type:hectometerpaal&fl=id,score,type,hectometernummer,hectometerletter,wegnummer&q={SEARCH_TERM}
# VITE_GEOCODER_LOOKUP_URL=https://api.pdok.nl/bzk/locatieserver/search/v3_1/lookup?id={SEARCH_TERM}
# WFS example:
VITE_GEOCODER_SEARCH_URL=https://tileserver2.incidentcentrale.nl/geoserver/ows?service=WFS&request=GetFeature&typeName=bps:bps_palen&outputFormat=application/json&version=2.0.0&srsName=EPSG%3A4326&propertyName=BPS,the_geom&sortBy=BPS+A&count=10&cql_filter=BPS%20ILIKE%20%27{SEARCH_TERM}%25%27

# Base path for application deployment
# / = Root of domain (default for development)
# /subpath/ = Subdirectory (override in .env.production if deploying to subdirectory)
VITE_BASE_PATH=/