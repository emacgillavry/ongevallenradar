# Base environment configuration for ongevallenradar
# Provides defaults for development
# Create .env.production to override specific values for production builds

# Use static GeoJSON files instead of live GeoServer
# true = Use local test data from /public/data/*.json (for development/testing)
# false = Use live WFS data from GeoServer (for production)
VITE_USE_STATIC_DATA=true

# WFS/GeoServer configuration (used when VITE_USE_STATIC_DATA=false)
VITE_WFS_HOST=
VITE_WFS_PATH=/geoserver/ows

# Tile server for base map tiles
# Development: OpenStreetMap public tiles
# Production: Override in .env.production
VITE_TILE_SERVER_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Geocoder API URLs
VITE_GEOCODER_SEARCH_URL=https://api.pdok.nl/bzk/locatieserver/search/v3_1/suggest?rows=10&fq=type:hectometerpaal&fl=id,score,type,hectometernummer,hectometerletter,wegnummer&q=
VITE_GEOCODER_LOOKUP_URL=https://api.pdok.nl/bzk/locatieserver/search/v3_1/lookup?id=

# Base path for application deployment
# / = Root of domain (default for development)
# /subpath/ = Subdirectory (override in .env.production if deploying to subdirectory)
VITE_BASE_PATH=/